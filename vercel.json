{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "drmhus-orgnls": {
      "root": "drmhus-orgnls",
      "framework": "vite",
      "installCommand": "npm install",
      "buildCommand": "npm run build",
      "bindings": [
        { "type": "service", "service": "server", "format": "url", "env": "SERVER_URL" }
      ]
    },
    "server": {
      "root": "server",
      "framework": "express",
      "installCommand": "npm install",
      "buildCommand": "echo 'server build complete'"
    }
  },
  "rewrites": [
    { "source": "/uploads/(.*)", "destination": { "service": "server" } },
    { "source": "/api/(.*)", "destination": { "service": "server" } },
    { "source": "/(.*)", "destination": { "service": "drmhus-orgnls" } }
  ]
}